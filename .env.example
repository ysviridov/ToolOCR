POSTGRES_DB=toolocr
POSTGRES_USER=toolocr
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
TOOLOCR_API_PORT=8080

# Stage 2: OCR service
TOOLOCR_OCR_PORT=8090
OCR_MAX_UPLOAD_MB=20
OCR_MAX_PIXELS=40000000
OCR_DEFAULT_LANG=rus+eng
OCR_DEFAULT_PSM=11

# Stage 2.1: метрическая калибровка фиксированной камеры сортировщика.
# Внутри контейнера каталог ./config смонтирован как /app/config.
LAYOUT_CAMERA_CALIBRATION=/app/config/camera-calibration.json
